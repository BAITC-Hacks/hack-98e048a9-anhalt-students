# ==============================================================================
# Environment Configuration Template (HackAlem AI)
# Copy this file to .env before starting: `cp .env.example .env`
# ==============================================================================

# Application Port & Host
PORT=3000
HOST=localhost
NODE_ENV=development

# LLM & Agent API Keys (Provide working keys or leave blank for mock demo mode)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Backend API URL (If running separate frontend & backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# PocketBase / Database URL (If applicable)
POCKETBASE_URL=http://127.0.0.1:8090

# Demo / Offline Mode (Set to true to use pre-recorded mock responses for judges)
DEMO_MOCK_MODE=true
